---
import { render } from "astro:content";
import { Image } from "astro:assets";
import Base from "@/layouts/Base.astro";
import { getPosts, formatDate, type Post } from "@/lib/posts";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map(post => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: Post;
}
const { post } = Astro.props;
const { title, description, pubDatetime, modDatetime, doodle } = post.data;
const { Content } = await render(post);
const updated = modDatetime && modDatetime.toDateString() !== pubDatetime.toDateString();
---

<Base title={title} description={description}>
  <article>
    {doodle && <Image src={doodle} alt="" width={400} class="post-header-doodle" />}
    <h1>{title}</h1>
    <p class="date">
      {formatDate(pubDatetime)}
      {updated && <span>(updated {formatDate(modDatetime)})</span>}
    </p>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>
