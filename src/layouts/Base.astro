---
import { SITE } from "@/config";
import "@/styles/site.css";

interface Props {
  title?: string;
  description?: string;
  /** The home page shows the full title block instead of the small running head */
  home?: boolean;
}

const { title, description = SITE.description, home = false } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.title}` : SITE.title;
const url = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <link rel="canonical" href={url} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=3" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png?v=3" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=3" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <script is:inline>
      // Light by default; remember the reader's choice. Runs before paint so there's no flash.
      try {
        document.documentElement.dataset.theme = localStorage.getItem("theme") || "light";
      } catch {
        document.documentElement.dataset.theme = "light";
      }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Courier+Prime:ital,wght@0,400;0,700;1,400;1,700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap"
    />
  </head>
  <body>
    {
      home ? (
        <header class="title-block">
          <h1>{SITE.title}</h1>
          <nav>
            <a href="/posts/">Writing</a>
            <a href="/about/">About</a>
            <button type="button" class="theme-toggle">Dark</button>
          </nav>
        </header>
      ) : (
        <header class="running-head">
          <a href="/">{SITE.title}</a>
          <nav>
            <a href="/posts/">Writing</a>
            <a href="/about/">About</a>
            <button type="button" class="theme-toggle">Dark</button>
          </nav>
        </header>
      )
    }

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      {SITE.links.map(link => <a href={link.href}>{link.name}</a>)}
      <a href="/rss.xml">RSS</a>
    </footer>
    <script is:inline>
      for (const button of document.querySelectorAll(".theme-toggle")) {
        const label = () => (button.textContent = document.documentElement.dataset.theme === "dark" ? "Light" : "Dark");
        label();
        button.addEventListener("click", () => {
          const theme = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
          document.documentElement.dataset.theme = theme;
          try {
            localStorage.setItem("theme", theme);
          } catch {}
          label();
        });
      }
    </script>
  </body>
</html>
