---
// Boxed side remark inside a post. Same API as the old AstroPaper component, so existing posts work.
interface Props {
  variant: "note" | "caution" | "oops" | "info";
}
const { variant } = Astro.props;
const label = { note: "Note", caution: "Caution", oops: "Oops", info: "Info" }[variant];
---

<aside class="aside">
  <strong>{label}.</strong>
  <slot />
</aside>
