---
import { Image } from "astro:assets";
import { formatDate, postUrl, type Post } from "@/lib/posts";

interface Props {
  posts: Post[];
}
const { posts } = Astro.props;
---

<ul class="post-list">
  {
    posts.map(post => (
      <li>
        {post.data.doodle && <Image src={post.data.doodle} alt="" width={160} class="post-doodle" />}
        <div>
          <a href={postUrl(post)} class="post-link">{post.data.title}</a>
          {post.data.draft && <span class="draft">(draft)</span>}
          <p class="post-desc">{post.data.description}</p>
          <time class="date" datetime={post.data.pubDatetime.toISOString()}>{formatDate(post.data.pubDatetime)}</time>
        </div>
      </li>
    ))
  }
</ul>
