---
// Posts as a hanging list, like the "Key Words and Phrases:" block on an old paper's first page
import { formatDate, postUrl, type Post } from "@/lib/posts";

interface Props {
  posts: Post[];
  label?: string;
}
const { posts, label = "Writing:" } = Astro.props;
---

<dl class="hanging">
  <dt>{label}</dt>
  <dd>
    <ul>
      {
        posts.map(post => (
          <li>
            <a href={postUrl(post)}>{post.data.title}</a>
            {post.data.draft && " (draft)"}
            <span class="date">{formatDate(post.data.pubDatetime)}</span>
          </li>
        ))
      }
    </ul>
  </dd>
</dl>
