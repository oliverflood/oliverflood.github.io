---
// A post's doodle. Shows the hand-drawn image from the post's `doodle` frontmatter if there is one;
// otherwise a placeholder blob whose shape and marker color are derived from the post id, so every
// post gets its own (and keeps it between builds).
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  seed: string;
  image?: ImageMetadata;
  size?: number;
  alt?: string;
}

const { seed, image, size = 72, alt = "" } = Astro.props;

// Small deterministic PRNG (mulberry32) seeded from a string hash
let h = 2166136261;
for (const c of seed) h = Math.imul(h ^ c.charCodeAt(0), 16777619);
const rand = () => {
  h = (h + 0x6d2b79f5) | 0;
  let t = Math.imul(h ^ (h >>> 15), 1 | h);
  t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
};

const colors = ["blue", "red", "green", "yellow"];
const color = colors[Math.floor(rand() * colors.length)];

// Wobbly closed blob: points around a circle with jittered radii, joined by a smooth curve
const n = 7 + Math.floor(rand() * 3);
const pts = Array.from({ length: n }, (_, i) => {
  const a = (i / n) * Math.PI * 2 + rand() * 0.4;
  const r = 30 + rand() * 12;
  return [50 + Math.cos(a) * r, 50 + Math.sin(a) * r];
});
const blob = (offset: number) => {
  const p = pts.map(([x, y]) => [x + offset, y - offset]);
  let d = `M${p[0][0].toFixed(1)},${p[0][1].toFixed(1)}`;
  for (let i = 0; i < n; i++) {
    const [p0, p1, p2, p3] = [-1, 0, 1, 2].map(k => p[(i + k + n) % n]);
    const c1 = [p1[0] + (p2[0] - p0[0]) / 6, p1[1] + (p2[1] - p0[1]) / 6];
    const c2 = [p2[0] - (p3[0] - p1[0]) / 6, p2[1] - (p3[1] - p1[1]) / 6];
    d += ` C${c1.map(v => v.toFixed(1))} ${c2.map(v => v.toFixed(1))} ${p2.map(v => v.toFixed(1))}`;
  }
  return d + "Z";
};
---

{
  image ? (
    <Image src={image} alt={alt} width={size * 2} class="doodle" style={`width:${size}px`} />
  ) : (
    <svg
      class={`doodle doodle-placeholder c-${color}`}
      viewBox="0 0 100 100"
      width={size}
      height={size}
      aria-hidden="true"
    >
      <path d={blob(0)} class="fill" />
      <path d={blob(2.5)} class="line" />
    </svg>
  )
}
